# Public browser configuration for Cloudflare Pages + Render API:
# VITE_DEEPSEEK_PROXY_URL=https://your-render-service.onrender.com/api/deepseek/chat

# Server-side key for `npm run build && npm run start` and Render Web Service.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional when the frontend is hosted on another origin (for example Cloudflare Pages).
# CORS_ORIGIN=https://your-pages-domain.pages.dev
