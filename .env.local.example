# Browser-only local fallback. Do not use this for public deployment.
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
# For Cloudflare Pages + Render API, set this at build time to:
# VITE_DEEPSEEK_PROXY_URL=https://your-render-service.onrender.com/api/deepseek/chat
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_ALIYUN_API_KEY=your_aliyun_api_key_here

# Server-side key for `npm run build && npm run start` and Render Web Service.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Optional when the frontend is hosted on another origin (for example Cloudflare Pages).
# CORS_ORIGIN=https://your-pages-domain.pages.dev

# Optional: prefer Aliyun/DashScope first for AI analysis and games.
# VITE_USE_ALIYUN_FIRST=true
